{
    "name": "cairophp/symfony-runtime-fixture",
    "description": "The Symfony app that tests/ServerTest.php serves with cairo serve public/index.php",
    "type": "project",
    "license": "Apache-2.0",
    "repositories": [
        {"type": "path", "url": "../..", "options": {"symlink": true}}
    ],
    "require": {
        "php": ">=8.2",
        "cairophp/symfony-runtime": "@dev",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "extra": {
        "runtime": {
            "class": "Cairo\\Symfony\\Runtime",
            "disable_dotenv": true
        }
    }
}
