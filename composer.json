{
    "name": "cairophp/symfony-runtime",
    "description": "Serve a Symfony app on the Cairo application server through its own front controller, with Symfony's Runtime component",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": [
        "symfony",
        "runtime",
        "cairo",
        "server"
    ],
    "require": {
        "php": "^8.2",
        "symfony/http-kernel": "^6.4|^7.0|^8.0",
        "symfony/runtime": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0|^12.0",
        "symfony/process": "^6.4|^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Cairo\\Symfony\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cairo\\Symfony\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": false
        }
    },
    "minimum-stability": "stable",
    "scripts": {
        "test": "phpunit"
    }
}
